{
  "theme": "Dark",
  "ai": {
    "provider": "ollama",
    "model": "gpt-4o-mini",
    "base_url": "https://api.openai.com/v1",
    "api_key": "",
    "temperature": 0.7,
    "timeout_seconds": 30
  },
  "logging": {
    "level": "Verbose"
  },
  "analytics": {
    "enabled": true
  },
  "auto_save": true,
  "modules": {
    "ai": true,
    "voice": true,
    "automation": false,
    "vision": false,
    "memory": false
  },
  "voice": {
    "mode": "always_on",
    "mic_device": 28,
    "mic_sensitivity": 0.015,
    "silence_duration_ms": 700,
    "noise_suppression": true,
    "stt_backend": "faster_whisper",
    "stt_model": "base.en",
    "stt_device": "cuda",
    "stt_compute_type": "float16",
    "stt_language": "en",
    "tts_backend": "kokoro",
    "tts_voice": "af_heart",
    "tts_device": "cuda",
    "tts_speed": 1.0,
    "wake_word_enabled": false,
    "wake_word": "saint",
    "wake_word_sensitivity": 0.5,
    "max_context_turns": 6,
    "system_prompt": "You are SAINT, a helpful AI assistant. Be concise. Respond naturally. If the user interrupts you, adapt immediately without apologising."
  }
}